# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# ── Required ────────────────────────────────────────────────────────────────
# Postgres connection. In Docker the host is `db`; locally it's localhost.
DATABASE_URL=postgres://quantumdb:CHANGE_ME@db:5432/quantumdb
# Postgres password (used by docker-compose.prod.yml to build the URL + init the DB).
POSTGRES_PASSWORD=CHANGE_ME
# Comma-separated API tokens for write/admin endpoints. Generate with ./tools/generate_token.sh
API_TOKENS=CHANGE_ME

# ── Production hardening (see docs/DEPLOYMENT.md) ────────────────────────────
# Allowed browser origins for cross-origin API calls. Unset = disallow all
# cross-origin (same-origin still works). `*` = any origin (fully public read API).
CORS_ALLOWED_ORIGINS=
# Set to 1 ONLY when behind a reverse proxy that overwrites X-Forwarded-For, so the
# per-IP rate limiter keys on the real client IP instead of the proxy's.
TRUST_PROXY=
# Set to 0 to hide the OpenAPI spec + Swagger UI in production (default: enabled).
ENABLE_SWAGGER=
# Listen address. Default 0.0.0.0:3000. For a direct (non-Docker) run behind a
# proxy on the same host, 127.0.0.1:3000 keeps the app off the public interface.
BIND_ADDR=
# Log level (error|warn|info|debug|trace).
RUST_LOG=info

# ── Local development only ───────────────────────────────────────────────────
# AUTH_DISABLED=1 bypasses the Bearer-token check entirely. NEVER set in production.
AUTH_DISABLED=
